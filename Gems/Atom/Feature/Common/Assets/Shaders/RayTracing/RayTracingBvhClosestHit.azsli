#pragma once

// Mirrors AZ::RayTracingBvh::IntersectClosest and the closest-hit walk in
// RayTracingBvhTraverse.azsl. PassSrg must expose nodes, ordered triangle vertices,
// primitive indices, and node count.
struct BvhTriangleHit
{
    float t;
    float u;
    float v;
    uint primitiveId;
    uint triangleSlot;
    uint hit;
};

BvhTriangleHit TraverseClosestHit(float3 origin, float3 direction, float tMax)
{
    BvhTriangleHit hit;
    hit.t = tMax;
    hit.u = 0.0f;
    hit.v = 0.0f;
    hit.primitiveId = 0;
    hit.triangleSlot = 0;
    hit.hit = 0;

    if (PassSrg::m_nodeCount == 0)
    {
        return hit;
    }

    const float3 invDir = 1.0f / direction;
    const BvhNode root = PassSrg::m_nodes[0];
    float rootTNear;
    if (!IntersectRayAabb(origin, invDir, root.aabbMin, root.aabbMax, hit.t, rootTNear))
    {
        return hit;
    }

    int stack[BVH_STACK_SIZE];
    float tNearStack[BVH_STACK_SIZE];
    int stackPtr = 0;
    stack[stackPtr] = 0;
    tNearStack[stackPtr] = rootTNear;
    ++stackPtr;
    while (stackPtr > 0)
    {
        --stackPtr;
        const int nodeIndex = stack[stackPtr];
        if (tNearStack[stackPtr] > hit.t)
        {
            continue;
        }

        const BvhNode node = PassSrg::m_nodes[nodeIndex];
        if (node.triangleCount > 0)
        {
            for (uint i = 0; i < node.triangleCount; ++i)
            {
                const uint slot = node.leftFirst + i;
                const float3 v0 = PassSrg::m_triangleVertices[3u * slot + 0u].xyz;
                const float3 v1 = PassSrg::m_triangleVertices[3u * slot + 1u].xyz;
                const float3 v2 = PassSrg::m_triangleVertices[3u * slot + 2u].xyz;
                float t, u, v;
                if (IntersectRayTriangle(origin, direction, v0, v1, v2, hit.t, t, u, v))
                {
                    hit.t = t;
                    hit.u = u;
                    hit.v = v;
                    hit.primitiveId = PassSrg::m_primitiveIndices[slot];
                    hit.triangleSlot = slot;
                    hit.hit = 1;
                }
            }
        }
        else
        {
            const int leftIndex = int(node.leftFirst);
            const int rightIndex = leftIndex + 1;
            const BvhNode leftNode = PassSrg::m_nodes[leftIndex];
            const BvhNode rightNode = PassSrg::m_nodes[rightIndex];
            float leftTNear;
            float rightTNear;
            const bool leftHit = IntersectRayAabb(
                origin, invDir, leftNode.aabbMin, leftNode.aabbMax, hit.t, leftTNear);
            const bool rightHit = IntersectRayAabb(
                origin, invDir, rightNode.aabbMin, rightNode.aabbMax, hit.t, rightTNear);

            if (leftHit && rightHit)
            {
                if (stackPtr + 2 <= BVH_STACK_SIZE)
                {
                    if (leftTNear <= rightTNear)
                    {
                        stack[stackPtr] = rightIndex;
                        tNearStack[stackPtr++] = rightTNear;
                        stack[stackPtr] = leftIndex;
                        tNearStack[stackPtr++] = leftTNear;
                    }
                    else
                    {
                        stack[stackPtr] = leftIndex;
                        tNearStack[stackPtr++] = leftTNear;
                        stack[stackPtr] = rightIndex;
                        tNearStack[stackPtr++] = rightTNear;
                    }
                }
            }
            else if (leftHit && stackPtr + 1 <= BVH_STACK_SIZE)
            {
                stack[stackPtr] = leftIndex;
                tNearStack[stackPtr++] = leftTNear;
            }
            else if (rightHit && stackPtr + 1 <= BVH_STACK_SIZE)
            {
                stack[stackPtr] = rightIndex;
                tNearStack[stackPtr++] = rightTNear;
            }
        }
    }
    return hit;
}
