#pragma once

// Mirrors AZ::RayTracingBvh::IntersectClosest and the closest-hit walk in
// RayTracingBvhTraverse.azsl. PassSrg must expose nodes, ordered triangle vertices,
// primitive indices, and node count.
struct BvhTriangleHit
{
    float t;
    float u;
    float v;
    uint primitiveId;
    uint triangleSlot;
    uint hit;
};

BvhTriangleHit TraverseClosestHit(float3 origin, float3 direction, float tMax)
{
    BvhTriangleHit hit;
    hit.t = tMax;
    hit.u = 0.0f;
    hit.v = 0.0f;
    hit.primitiveId = 0;
    hit.triangleSlot = 0;
    hit.hit = 0;

    if (PassSrg::m_nodeCount == 0)
    {
        return hit;
    }

    const float3 invDir = 1.0f / direction;
    int stack[BVH_STACK_SIZE];
    int stackPtr = 0;
    stack[stackPtr++] = 0;
    while (stackPtr > 0)
    {
        const BvhNode node = PassSrg::m_nodes[stack[--stackPtr]];
        if (!IntersectRayAabb(origin, invDir, node.aabbMin, node.aabbMax, hit.t))
        {
            continue;
        }

        if (node.triangleCount > 0)
        {
            for (uint i = 0; i < node.triangleCount; ++i)
            {
                const uint slot = node.leftFirst + i;
                const float3 v0 = PassSrg::m_triangleVertices[3u * slot + 0u].xyz;
                const float3 v1 = PassSrg::m_triangleVertices[3u * slot + 1u].xyz;
                const float3 v2 = PassSrg::m_triangleVertices[3u * slot + 2u].xyz;
                float t, u, v;
                if (IntersectRayTriangle(origin, direction, v0, v1, v2, hit.t, t, u, v))
                {
                    hit.t = t;
                    hit.u = u;
                    hit.v = v;
                    hit.primitiveId = PassSrg::m_primitiveIndices[slot];
                    hit.triangleSlot = slot;
                    hit.hit = 1;
                }
            }
        }
        else if (stackPtr + 2 <= BVH_STACK_SIZE)
        {
            stack[stackPtr++] = int(node.leftFirst);
            stack[stackPtr++] = int(node.leftFirst) + 1;
        }
    }
    return hit;
}
