// Fullscreen hardware-agnostic hard ray-traced shadows.
//
// For every pixel: reconstruct the world position from the depth buffer, cast occlusion rays
// toward the directional light against the software BVH (built on the CPU by AZ::RayTracingBvh),
// and darken the pixel by the occluded fraction. With m_sampleCount > 1 the rays are spread over
// the light's disk (soft shadows with contact hardening, mirroring
// AZ::ComputeSoftShadowVisibility); with 1 sample it is a hard shadow. The output is multiplicatively blended
// onto the lighting target (Zero/ColorSource), so a lit pixel is untouched and a shadowed pixel is
// scaled by the shadow factor. Uses only a standard pixel shader + structured buffers, with NO
// dependency on DXR / VK_KHR_ray_tracing or RT cores, so it runs on every RHI backend.

#include <Atom/Features/SrgSemantics.azsli>
#include <viewsrg_all.srgi>

#include <Atom/Features/PostProcessing/FullscreenPixelInfo.azsli>
#include <Atom/Features/PostProcessing/FullscreenVertex.azsli>

#include "RayTracingBvh.azsli"

// A point / spot / disk light that casts ray-traced shadows. Mirrors AZ::LocalShadowLight and the
// pass's packed upload layout (64 bytes).
struct LocalShadowLight
{
    float3 m_position;
    float m_radius;
    float3 m_diskNormal;                 // zero = sphere light (sample disk faces the receiver)
    float m_intensity;                   // luminance, candela
    float3 m_spotDirection;              // zero = omnidirectional
    float m_invAttenuationRadiusSquared; // 0 = infinite range
    float m_cosInnerConeAngle;
    float m_cosOuterConeAngle;
    float2 m_padding;
};

ShaderResourceGroup PassSrg : SRG_PerPass
{
    // Occluder BVH (AZ::RayTracingBvh::GetNodes()).
    StructuredBuffer<BvhNode> m_nodes;

    // Occluder triangle vertices in BVH leaf order: 3 float4 per triangle, xyz used
    // (AZ::RayTracingBvh::GetOrderedTriangles()).
    StructuredBuffer<float4> m_triangleVertices;

    // Scene depth (reversed depth: 0 = far plane / nothing rendered).
    Texture2D<float> m_depth;

    // Direction from surface toward the light (normalized on the CPU).
    float3 m_toLight;
    // Maximum occlusion-ray distance.
    float m_maxDistance;
    // Offset of the ray origin along the ray to avoid self-shadow acne.
    float m_rayBias;
    // Multiplier applied to shadowed pixels (0 = black, 1 = no visible shadow).
    float m_shadowFactor;
    // Number of BVH nodes; 0 disables traversal.
    uint m_nodeCount;

    // Soft shadows: tan(angular radius of the light's disk); 0 = hard shadow.
    float m_tanAngularRadius;
    // Rays per pixel over the light's disk; <= 1 = hard shadow.
    uint m_sampleCount;
    // Probe rays cast first (AZ::GetSoftShadowProbeCount); if they all agree, the rest are skipped.
    uint m_probeCount;
    // 1 = adaptive probe early-out on, 0 = always cast m_sampleCount rays.
    uint m_adaptive;
    // Per-frame offset of the per-pixel pattern rotation (0 = static pattern).
    uint m_noiseFrame;

    // Local lights (most important first) and how much the directional light's shadow counts
    // (its illuminance in lux; 0 = no directional shadow).
    StructuredBuffer<LocalShadowLight> m_localLights;
    uint m_localLightCount;
    float m_directionalWeight;
    // Local-light rays stop this far before the light so its own fixture does not shadow it.
    float m_lightClearance;
}

#include "RayTracingBvhAnyHit.azsli"

// Golden angle, pi * (3 - sqrt(5)).
#define SOFT_SHADOW_GOLDEN_ANGLE 2.39996323f

// Mirrors AZ::ComputeSoftShadowRayDirection: Vogel disk point of radius tanAngularRadius around n.
void OrthonormalBasis(float3 n, out float3 tangent, out float3 bitangent)
{
    // Branchless orthonormal basis (Duff et al. 2017), as in AZ::ComputeSoftShadowRayDirection.
    const float sign = n.z >= 0.0f ? 1.0f : -1.0f;
    const float a = -1.0f / (sign + n.z);
    const float b = n.x * n.y * a;
    tangent = float3(1.0f + sign * n.x * n.x * a, sign * b, -sign * n.x);
    bitangent = float3(b, sign + n.y * n.y * a, -n.y);
}

float2 VogelDiskPoint(uint sampleIndex, uint sampleCount, float rotation)
{
    const float radius = sqrt((float(sampleIndex) + 0.5f) / float(max(1u, sampleCount)));
    const float theta = float(sampleIndex) * SOFT_SHADOW_GOLDEN_ANGLE + rotation;
    return radius * float2(cos(theta), sin(theta));
}

float3 SoftShadowRayDirection(float3 n, float tanAngularRadius, uint sampleIndex, uint sampleCount, float rotation)
{
    float3 tangent, bitangent;
    OrthonormalBasis(n, tangent, bitangent);
    const float2 disk = VogelDiskPoint(sampleIndex, sampleCount, rotation) * tanAngularRadius;
    return normalize(n + tangent * disk.x + bitangent * disk.y);
}

// Mirrors AZ::ComputeLocalLightIlluminance.
float LocalLightIlluminance(LocalShadowLight light, float3 receiver)
{
    const float3 toLight = light.m_position - receiver;
    const float distanceSquared = dot(toLight, toLight);
    const float falloff = distanceSquared * light.m_invAttenuationRadiusSquared;
    if (falloff >= 1.0f || light.m_intensity <= 0.0f)
    {
        return 0.0f;
    }
    float radiusAttenuation = 1.0f - falloff * falloff;
    radiusAttenuation *= radiusAttenuation;
    float illuminance = light.m_intensity / max(distanceSquared, 1.0e-6f) * radiusAttenuation;

    if (any(light.m_spotDirection != 0.0f))
    {
        const float cosAngle = dot(-normalize(toLight), normalize(light.m_spotDirection));
        if (cosAngle <= light.m_cosOuterConeAngle)
        {
            return 0.0f;
        }
        if (cosAngle < light.m_cosInnerConeAngle)
        {
            const float t = (cosAngle - light.m_cosOuterConeAngle) / (light.m_cosInnerConeAngle - light.m_cosOuterConeAngle);
            illuminance *= t * t * (3.0f - 2.0f * t);
        }
    }
    return illuminance;
}

// Mirrors AZ::ComputeLocalLightSamplePoint.
float3 LocalLightSamplePoint(LocalShadowLight light, float3 receiver, uint sampleIndex, uint sampleCount, float rotation)
{
    if (sampleCount <= 1u || light.m_radius <= 0.0f)
    {
        return light.m_position;
    }
    const float3 n = any(light.m_diskNormal != 0.0f) ? normalize(light.m_diskNormal) : normalize(light.m_position - receiver);
    float3 tangent, bitangent;
    OrthonormalBasis(n, tangent, bitangent);
    const float2 disk = VogelDiskPoint(sampleIndex, sampleCount, rotation) * light.m_radius;
    return light.m_position + tangent * disk.x + bitangent * disk.y;
}

// Interleaved gradient noise (Jimenez 2014): cheap per-pixel value in [0, 1) that turns the fixed
// sample pattern into fine noise (and is smoothed out by TAA when the pattern is animated).
float InterleavedGradientNoise(float2 pixel, uint frame)
{
    pixel += 5.588238f * float(frame & 63u);
    return frac(52.9829189f * frac(dot(pixel, float2(0.06711056f, 0.00583715f))));
}

bool LocalLightRayOccluded(LocalShadowLight light, float3 position, uint sampleIndex, uint sampleCount, float rotation)
{
    const float3 toTarget = LocalLightSamplePoint(light, position, sampleIndex, sampleCount, rotation) - position;
    const float distance = length(toTarget);
    const float3 direction = toTarget / max(distance, 1.0e-6f);
    const float bias = PassSrg::m_rayBias;
    const float tMax = distance - bias - PassSrg::m_lightClearance;
    return tMax > 0.0f && TraverseAnyHit(position + direction * bias, direction, tMax);
}

// Mirrors AZ::ComputeLocalLightShadowVisibility.
float LocalLightVisibility(LocalShadowLight light, float3 position, float rotation)
{
    const uint sampleCount = light.m_radius > 0.0f ? max(1u, PassSrg::m_sampleCount) : 1u;
    if (sampleCount == 1u)
    {
        return LocalLightRayOccluded(light, position, 0u, 1u, rotation) ? 0.0f : 1.0f;
    }

    const uint probeCount = clamp(PassSrg::m_probeCount, 1u, sampleCount);
    const uint firstProbe = sampleCount - probeCount;
    uint hits = 0;
    for (uint probe = firstProbe; probe < sampleCount; ++probe)
    {
        hits += LocalLightRayOccluded(light, position, probe, sampleCount, rotation) ? 1u : 0u;
    }
    if (PassSrg::m_adaptive != 0u && (hits == 0u || hits == probeCount))
    {
        return hits == 0u ? 1.0f : 0.0f;
    }
    for (uint index = 0; index < firstProbe; ++index)
    {
        hits += LocalLightRayOccluded(light, position, index, sampleCount, rotation) ? 1u : 0u;
    }
    return 1.0f - float(hits) / float(sampleCount);
}

PSOutput MainPS(VSOutput IN)
{
    PSOutput OUT;
    OUT.m_color = float4(1.0f, 1.0f, 1.0f, 1.0f);

    const int2 pixel = int2(IN.m_position.xy);
    const float depth = PassSrg::m_depth.Load(int3(pixel, 0)).r;

    // Reversed depth: 0 means nothing was rendered here (sky) - leave it untouched.
    if (depth <= 0.0f)
    {
        return OUT;
    }

    // Reconstruct the world position from the depth buffer.
    const float2 uv = IN.m_texCoord;
    const float2 ndc = float2(uv.x * 2.0f - 1.0f, 1.0f - uv.y * 2.0f);
    float4 worldPos = mul(ViewSrg::m_viewProjectionInverseMatrix, float4(ndc, depth, 1.0f));
    worldPos /= worldPos.w;

    const float3 toLight = normalize(PassSrg::m_toLight);
    const float3 position = worldPos.xyz;
    const float tMax = PassSrg::m_maxDistance;
    const float bias = PassSrg::m_rayBias;

    // Each light's shadow counts in proportion to the illuminance it brings to this pixel, so the
    // single darkening factor below is the fraction of the total incoming light that is blocked.
    const float rotation = InterleavedGradientNoise(float2(pixel), PassSrg::m_noiseFrame) * 6.28318531f;
    float totalWeight = 0.0f;
    float visibleWeight = 0.0f;
    if (PassSrg::m_directionalWeight > 0.0f)
    {
        float visibility;
        const uint sampleCount = PassSrg::m_sampleCount;
        if (sampleCount <= 1u || PassSrg::m_tanAngularRadius <= 0.0f)
        {
            visibility = TraverseAnyHit(position + toLight * bias, toLight, tMax) ? 0.0f : 1.0f;
        }
        else
        {
            // Mirrors AZ::ComputeSoftShadowVisibility: the last probeCount samples (outer ring of the
            // disk) first, then the rest only if they disagree, i.e. the pixel is in the penumbra.
            const float tanRadius = PassSrg::m_tanAngularRadius;
            const uint probeCount = clamp(PassSrg::m_probeCount, 1u, sampleCount);
            const uint firstProbe = sampleCount - probeCount;

            uint hits = 0;
            for (uint probe = firstProbe; probe < sampleCount; ++probe)
            {
                const float3 direction = SoftShadowRayDirection(toLight, tanRadius, probe, sampleCount, rotation);
                hits += TraverseAnyHit(position + direction * bias, direction, tMax) ? 1u : 0u;
            }

            if (PassSrg::m_adaptive != 0u && (hits == 0u || hits == probeCount))
            {
                visibility = hits == 0u ? 1.0f : 0.0f;
            }
            else
            {
                for (uint index = 0; index < firstProbe; ++index)
                {
                    const float3 direction = SoftShadowRayDirection(toLight, tanRadius, index, sampleCount, rotation);
                    hits += TraverseAnyHit(position + direction * bias, direction, tMax) ? 1u : 0u;
                }
                visibility = 1.0f - float(hits) / float(sampleCount);
            }
        }
        totalWeight += PassSrg::m_directionalWeight;
        visibleWeight += PassSrg::m_directionalWeight * visibility;
    }

    for (uint lightIndex = 0; lightIndex < PassSrg::m_localLightCount; ++lightIndex)
    {
        const LocalShadowLight light = PassSrg::m_localLights[lightIndex];
        const float weight = LocalLightIlluminance(light, position);
        if (weight > 0.0f)
        {
            totalWeight += weight;
            visibleWeight += weight * LocalLightVisibility(light, position, rotation);
        }
    }
    const float visibility = totalWeight > 0.0f ? visibleWeight / totalWeight : 1.0f;

    // Lit = 1 (untouched), umbra = m_shadowFactor, penumbra in between.
    const float factor = lerp(PassSrg::m_shadowFactor, 1.0f, visibility);
    OUT.m_color.rgb = float3(factor, factor, factor);

    return OUT;
}
