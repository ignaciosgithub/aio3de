#pragma once

// Mirrors AZ::RayTracingBvh::IntersectAny and the former TraverseAnyHit in
// RayTracedShadowsFullscreen.azsl. PassSrg must expose m_nodes, m_triangleVertices, and m_nodeCount.
bool TraverseAnyHit(float3 origin, float3 direction, float tMax)
{
    if (PassSrg::m_nodeCount == 0)
    {
        return false;
    }

    const float3 invDir = 1.0f / direction;
    const BvhNode root = PassSrg::m_nodes[0];
    if (!IntersectRayAabb(origin, invDir, root.aabbMin, root.aabbMax, tMax))
    {
        return false;
    }

    int stack[BVH_STACK_SIZE];
    int stackPtr = 0;
    stack[stackPtr++] = 0;
    while (stackPtr > 0)
    {
        const BvhNode node = PassSrg::m_nodes[stack[--stackPtr]];
        if (node.triangleCount > 0)
        {
            for (uint i = 0; i < node.triangleCount; ++i)
            {
                const uint slot = node.leftFirst + i;
                const float3 v0 = PassSrg::m_triangleVertices[3u * slot + 0u].xyz;
                const float3 v1 = PassSrg::m_triangleVertices[3u * slot + 1u].xyz;
                const float3 v2 = PassSrg::m_triangleVertices[3u * slot + 2u].xyz;
                float t, u, v;
                if (IntersectRayTriangle(origin, direction, v0, v1, v2, tMax, t, u, v))
                {
                    return true;
                }
            }
        }
        else
        {
            const int leftIndex = int(node.leftFirst);
            const int rightIndex = leftIndex + 1;
            const BvhNode leftNode = PassSrg::m_nodes[leftIndex];
            const BvhNode rightNode = PassSrg::m_nodes[rightIndex];
            float leftTNear;
            float rightTNear;
            const bool leftHit = IntersectRayAabb(
                origin, invDir, leftNode.aabbMin, leftNode.aabbMax, tMax, leftTNear);
            const bool rightHit = IntersectRayAabb(
                origin, invDir, rightNode.aabbMin, rightNode.aabbMax, tMax, rightTNear);

            if (leftHit && rightHit)
            {
                if (stackPtr + 2 <= BVH_STACK_SIZE)
                {
                    if (leftTNear <= rightTNear)
                    {
                        stack[stackPtr++] = rightIndex;
                        stack[stackPtr++] = leftIndex;
                    }
                    else
                    {
                        stack[stackPtr++] = leftIndex;
                        stack[stackPtr++] = rightIndex;
                    }
                }
            }
            else if (leftHit && stackPtr + 1 <= BVH_STACK_SIZE)
            {
                stack[stackPtr++] = leftIndex;
            }
            else if (rightHit && stackPtr + 1 <= BVH_STACK_SIZE)
            {
                stack[stackPtr++] = rightIndex;
            }
        }
    }
    return false;
}
