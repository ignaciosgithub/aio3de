{
    "version": 1,
    "blackboard": {
        "alert": { "type": "bool", "value": false },
        "target": { "type": "vector3", "value": [0, 0, 0] },
        "patrolA": { "type": "vector3", "value": [0, 0, 0] },
        "patrolB": { "type": "vector3", "value": [0, 0, 0] }
    },
    "root": {
        "type": "Selector",
        "name": "Platformer Enemy",
        "reactive": true,
        "children": [
            {
                "type": "Sequence",
                "children": [
                    { "type": "CheckBlackboard", "key": "alert", "op": "IsTrue" },
                    {
                        "type": "Selector",
                        "reactive": true,
                        "children": [
                            {
                                "type": "Sequence",
                                "children": [
                                    { "type": "Condition", "name": "InTouchRange" },
                                    { "type": "Action", "name": "Touch" }
                                ]
                            },
                            { "type": "MoveTo", "targetKey": "target", "acceptanceRadius": 1.0, "speed": 3.0 }
                        ]
                    }
                ]
            },
            {
                "type": "Sequence",
                "children": [
                    { "type": "MoveTo", "targetKey": "patrolA", "acceptanceRadius": 0.5, "speed": 2.0 },
                    { "type": "Wait", "seconds": 0.5 },
                    { "type": "MoveTo", "targetKey": "patrolB", "acceptanceRadius": 0.5, "speed": 2.0 },
                    { "type": "Wait", "seconds": 0.5 }
                ]
            }
        ]
    }
}
